{
  "name": "dsh-client-ui-frosted-glass",
  "description": "Global frosted-glass (backdrop blur) theme plugin for the dsh web UI with animated light/dark switching, a scheduled theme timer, a composer glow lighting effect, system notifications and a Monet (Material You) wallpaper color-extraction theme",
  "version": "0.5.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "assets/bg.jpeg",
    "cordis.patch.yml",
    "lib/client.js",
    "lib/index.js"
  ],
  "dependencies": {
    "wallpaper": "^7.3.1"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.5",
    "react": "^18.2.0"
  }
}
